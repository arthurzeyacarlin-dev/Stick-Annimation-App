{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diamond-animator/spec0001-browser/action-registry-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "actions"],
  "properties": {
    "registryVersion": {"const": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "target", "scope"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["click", "fill", "press", "resize", "assert-enabled", "assert-visible", "assert-disabled", "assert-inert", "assert-visible-change", "assert-settled", "click-and-assert"]},
          "target": {"type": "string", "minLength": 1},
          "scope": {"enum": ["each-viewport-welcome", "each-viewport-stick", "drawing-initial", "drawing-resized"]}
        }
      }
    }
  }
}
